import pandas as pd

from sklearn.compose import ColumnTransformer

from sklearn.pipeline import Pipeline

from sklearn.impute import SimpleImputer

from sklearn.preprocessing import OneHotEncoder, StandardScaler

from sklearn.ensemble import RandomForestClassifier

df = pd.DataFrame ({'age': [25,35,

None, 45], 'income': [50,40,30,60], 'city':['X', 'Y', 'X', 'Z'],'target': [0,1,

0,1]})

X = df[['age', 'income', 'city']]; y = df['target']

numeric features = ['age', 'income']

numeric transformer = Pipeline ([('imputer',

SimpleImputer(strategy='median')), ('scaler', StandardScaler())])

cat features = ['city']; cat_transformer = Pipeline([('onehot',

OneHotEncoder (handle unknown='ignore'))])

preprocessor = ColumnTransformer([('num', numeric transformer,

numeric features), ('cat', cat transformer, cat features)])

clf = Pipeline([('pre', preprocessor), ('rf',

RandomForestClassifier (random state=42))])

clf.fit (X,y)

print('Preprocessor output shape:',

preprocessor.transform(X). toarray().shape)

print('Pipeline trained successfully.')
Preprocessor output shape: (4, 5)
